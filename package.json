{
  "name": "ctxmeter",
  "version": "0.1.2",
  "private": false,
  "description": "See what your AI coding agent loads into context before you type, and switch off what you pick. Claude Code, Codex, Kiro. Local, no account.",
  "license": "MIT",
  "homepage": "https://github.com/HaeDalWang/ctxmeter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaeDalWang/ctxmeter.git"
  },
  "bugs": {
    "url": "https://github.com/HaeDalWang/ctxmeter/issues"
  },
  "type": "commonjs",
  "bin": {
    "ctxmeter": "src/cli.js"
  },
  "files": [
    "src",
    "config",
    "README.md",
    "docs/demo.gif",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude-code",
    "codex",
    "kiro",
    "context-window",
    "mcp",
    "tokens",
    "observability",
    "cli",
    "claude",
    "ai-agents",
    "context-engineering",
    "developer-tools"
  ],
  "scripts": {
    "audit": "node src/cli.js audit",
    "scan": "node src/cli.js scan",
    "telemetry": "node src/cli.js telemetry",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "demo": "./scripts/build-demo.sh",
    "prepublishOnly": "node --test"
  },
  "publishConfig": {
    "access": "public"
  }
}
